# Copy to .env and fill in your own values. .env is gitignored — never commit it.

# Razorpay API credentials (Settings -> API Keys in the Razorpay dashboard).
# Use the rzp_test_... pair while testing, rzp_live_... only once you're ready
# to take real payments.
RAZOR_PAY_API_KEY=
RAZOR_PAY_SECRET=

# Where to send the visitor after Razorpay confirms payment succeeded.
# Relative path (e.g. /thank-you.html) or full URL. Leave blank to stay on
# the in-page confirmation instead of redirecting.
RAZORPAY_SUCCESS_REDIRECT_URL=

# Where to send the visitor after a payment fails or verification fails.
# Leave blank to show an inline error on the form instead of redirecting.
RAZORPAY_FAILURE_REDIRECT_URL=
